{
  "name": "clubstack",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:mobile": "pnpm --filter mobile start",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm --filter web lint",
    "lint:mobile": "pnpm --filter mobile exec tsc --noEmit",
    "test": "pnpm --filter web test",
    "test:watch": "pnpm --filter web test:watch",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.ts",
    "db:migrate": "supabase db push",
    "db:reset": "supabase db reset",
    "sync-instructions": "npx ts-node scripts/sync-instructions.ts",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "glob": "^13.0.6",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "simple-git-hooks": "^2.11.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
